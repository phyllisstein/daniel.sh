{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": [
    "source.fixAll.stylelint",
    "source.fixAll.oxc"
  ],
  "eslint.enable": false,
  "stylelint.enable": true,
  "stylelint.validate": [
    "css",
    "less",
    "postcss",
    "typescript",
    "typescriptreact"
  ],
  "editor.tabSize": 4
}
